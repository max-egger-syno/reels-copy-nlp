# Allowlist: everything is ignored unless listed below.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/config.py
!/run_all.py

!/src/
/src/__pycache__/

!/scripts/
/scripts/*
!/scripts/build_human_test.py
!/scripts/extract_anew_br.py
!/scripts/make_outputs.py
!/scripts/score_human_test.py
!/scripts/watch_and_process.py

!/collection/
/collection/*
!/collection/collect_reels_snippet.js

!/data/
/data/*
!/data/creators.csv

!/report/
/report/*
!/report/main.tex
!/report/fig_e3_pairwise_accuracy.png
!/report/Final_Report.pdf

!/results/
/results/human_test_answers.csv

!/figures/
!/cards/
!/notebook/
!/human_test/

!/tests/
/tests/synthetic/*
!/tests/synthetic/make_synthetic.py

__pycache__/
*.pyc
.ipynb_checkpoints/
*.wav
*.mp4
*.m4a
cookies.txt
